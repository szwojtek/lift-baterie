---
import { Image } from 'astro:assets';
import type { Photo } from '../config/photos';

interface Props {
  photo: Photo;
}

const { photo } = Astro.props;
---

{/*
  Drop inside a `relative isolate bg-ink-900` hero section.

  Two overlays, not one. The horizontal ramp keeps the copy column dark enough
  for white text; the flat veil stops the uncovered third turning into a bright
  patch. Measured on the home hero at 1280px: white-on-background contrast runs
  18.9:1 at the left edge and 10.2:1 at its worst point under the headline,
  against a 4.5:1 requirement.

  Both overlays are <span>, not <div>: global.css forces `position: relative`
  on direct div children of the hero section, which would defeat `absolute`.
*/}
<Image
  src={photo.src}
  alt={photo.alt}
  widths={[768, 1280, 1920]}
  sizes="100vw"
  loading="eager"
  fetchpriority="high"
  class="absolute inset-0 -z-10 h-full w-full object-cover object-right opacity-70"
/>
<span
  aria-hidden="true"
  class="absolute inset-0 -z-10 bg-gradient-to-r from-ink-900 via-ink-900/85 to-transparent"
></span>
<span aria-hidden="true" class="absolute inset-0 -z-10 bg-ink-900/25"></span>
