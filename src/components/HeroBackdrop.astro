---
import { Image } from 'astro:assets';
import type { Photo } from '../config/photos';

interface Props {
  photo: Photo;
  /**
   * Below `sm` the mobile hero box is taller, relative to its width, than a
   * 16:9 source frame can fill without cropping away most of its width
   * (measured on LFB-003: >55% cut, see artifacts/lift-baterie/LFB-003/README.md).
   * Hiding it there costs zero bytes: `loading="lazy"` on an element inside a
   * `hidden` ancestor never becomes an intersection candidate, so the browser
   * never requests it below `sm`. From `sm` up the photo returns at full
   * quality; only the loading priority (not the crop) is the trade-off.
   */
  hideBelowSm?: boolean;
}

const { photo, hideBelowSm = false } = Astro.props;
---

{/*
  Drop inside a `relative isolate bg-ink-900` hero section.

  Both wrappers are <span>, not <div>: global.css forces `position: relative`
  on direct div children of the hero section, which would defeat `absolute`.
*/}
<span
  class:list={[
    'hero-photo-wrap absolute inset-y-0 right-0 -z-10 w-full sm:w-[68%]',
    hideBelowSm ? 'hidden sm:block' : 'block',
  ]}
>
  {/*
    fetchpriority is deliberately NOT tied to hideBelowSm, unlike loading below.
    loading has to stay coupled to it -- it's the only lever that gets zero
    bytes below `sm` (an `eager` image ignores its hidden ancestor and fetches
    anyway). But fetchpriority only affects how urgently an ALREADY-decided
    fetch runs, never whether it happens, so there's no reason to downgrade it
    just because the image happens to be behind hideBelowSm on this page: at
    sm+, where hideBelowSm pages show this exact photo, it's still the hero's
    primary visual and a likely LCP element (LFB-003 code review caught this
    coupling as a real regression on 5 of 7 pages before this fix).

    quality={72} (was the astro:assets default, 80): 79.8 KB -> 61.1 KB on the
    800w mobile variant, still visually indistinguishable behind the veil/
    gradient (LFB-003 Position 2, target <=75 KB at DPR2/390px -- see
    artifacts/lift-baterie/LFB-003/README.md).
  */}
  <Image
    src={photo.src}
    alt={photo.alt}
    widths={[640, 800, 1024, 1200, 1600]}
    sizes="(min-width: 640px) 68vw, 100vw"
    loading={hideBelowSm ? 'lazy' : 'eager'}
    fetchpriority="high"
    quality={72}
    class="hero-photo h-full w-full object-cover object-center"
  />
</span>
{/*
  Below `sm` the photo (where it isn't hidden) runs full width and this veil
  alone carries the contrast. At `sm+` it stays on at a lower, uniform 45% so
  every pixel behind the text has a dark floor regardless of what the photo
  looks like there; the gradient below adds the extra, left-to-right darkening
  on top of it (LFB-003 — see the mask's comment for the worst-case numbers).
*/}
<span aria-hidden="true" class="absolute inset-0 -z-10 bg-ink-900/65 sm:bg-ink-900/45"></span>
<span
  aria-hidden="true"
  class="absolute inset-0 -z-10 hidden sm:block sm:bg-gradient-to-r sm:from-ink-900 sm:from-45% sm:via-ink-900/75 sm:via-70% sm:to-ink-900/50"
></span>

<style>
  /*
   * Mask and gradient used to run at every width and, below `sm`, stacked on
   * top of an already 16:9-into-portrait crop: two extra layers of darkening
   * on top of the worst-cropped part of the frame (LFB-003, Spec B). Scoping
   * both to `sm+` leaves the veil above as the sole mobile contrast layer.
   *
   * The 70% cutoff (was 52%) is wider than the split-hero design implies:
   * `max-w-3xl` on the heading only constrains it once the container itself
   * is wider than ~800px. Below that (LFB-003 measured 640-768px), the
   * container is narrower than `max-w-3xl`, so the heading runs the full row
   * width and can sit directly over the photo's brightest area — measured
   * worst-case contrast against the original 52%/to-transparent pair was as
   * low as 1.17:1 at 640px. The uniform 45% veil plus this gradient (see the
   * span above) is what actually closes that gap for bright source pixels;
   * the mask's job is the left-edge feather, not the contrast floor.
   */
  @media (min-width: 640px) {
    .hero-photo-wrap {
      -webkit-mask-image: linear-gradient(to right, transparent 0%, #000 70%);
      mask-image: linear-gradient(to right, transparent 0%, #000 70%);
    }
  }

  /* Ken Burns (LFB-003 Position 3): transform-only, so it composites on its
     own layer and costs no layout/paint per frame. Off entirely under
     reduced motion, same gate as the rest of global.css's motion system. */
  @media (prefers-reduced-motion: no-preference) {
    .hero-photo {
      animation: hero-ken-burns 20s ease-in-out infinite alternate;
      will-change: transform;
    }
  }
  @keyframes hero-ken-burns {
    from {
      transform: scale(1);
    }
    to {
      transform: scale(1.06);
    }
  }
</style>
