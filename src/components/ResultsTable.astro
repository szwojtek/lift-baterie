---
import Photo from './Photo.astro';
import { PHOTOS } from '../config/photos';
import { RESULTS, BEST_RESULT, GAIN_FACTOR_LABEL, END_OF_LIFE_PCT } from '../config/results';

interface Props {
  title?: string;
  /** Tinted band by default; pass false when the neighbouring section is tinted. */
  tinted?: boolean;
}

const {
  title = 'Wybrane realizacje: pojemność przed i po regeneracji',
  tinted = true,
} = Astro.props;

const gain = BEST_RESULT.after - BEST_RESULT.before;
// The time line needs both durations from the report; older rows only carry Ah.
const hasTimes = Boolean(BEST_RESULT.beforeTime && BEST_RESULT.afterTime);
// "Ta bateria była poniżej granicy zużycia" is only true when the intake reading sat under the line.
const wasBelowLine = BEST_RESULT.before < END_OF_LIFE_PCT;
---

<section class={tinted ? 'bg-gray-50' : ''}>
  <div class="mx-auto max-w-6xl px-4 py-16">
    <h2 class="border-l-4 border-brand-500 pl-4 font-display text-2xl font-bold sm:text-3xl">
      {title}
    </h2>

    {/* The first number a reader sees is a result, never the 80% floor (LFB-001). */}
    <p class="mt-6 font-display text-3xl font-bold sm:text-4xl">
      <span class="text-brand-600">Z {BEST_RESULT.before}% do {BEST_RESULT.after}%.</span>
      {wasBelowLine && <span class="text-gray-700"> Ta bateria była poniżej granicy zużycia.</span>}
    </p>

    <p class="mt-4 max-w-3xl text-gray-700">
      Każdą baterię rozładowujemy pod kontrolą urządzenia przed regeneracją i po niej. Poniżej
      odczyty z raportów urządzenia. To nie są szacunki, tylko zmierzona pojemność jako procent
      wartości znamionowej.
      {hasTimes ? (
        <>
          Bateria oddała <strong>{GAIN_FACTOR_LABEL} razy więcej pojemności</strong>:
          {' '}{BEST_RESULT.afterTime} pod tym samym obciążeniem zamiast {BEST_RESULT.beforeTime}.
        </>
      ) : (
        <>
          Mocniejszy z tych wyników to <strong>wzrost o {gain} punktów procentowych</strong>.
        </>
      )}
    </p>

    <div class="mt-10 grid gap-8 lg:grid-cols-[1fr_1.1fr] lg:items-start">
      <div class="grid gap-6 lg:order-1">
        {
          RESULTS.map((r) => (
            <div class="rounded-2xl border border-gray-200 bg-white p-6">
              <p class="text-sm font-semibold text-gray-500">{r.battery}</p>
              <div class="mt-4 flex items-end gap-4">
                <div>
                  <p class="text-xs font-semibold uppercase tracking-wide text-gray-400">Przy przyjęciu</p>
                  <p class="font-display text-2xl font-bold text-gray-400">{r.before}%</p>
                </div>
                <p aria-hidden="true" class="pb-2 text-2xl text-brand-300">→</p>
                <div>
                  <p class="text-xs font-semibold uppercase tracking-wide text-brand-600">Po regeneracji</p>
                  <p class="font-display text-4xl font-bold text-brand-600">{r.after}%</p>
                </div>
              </div>
              <p class="mt-4 text-sm text-gray-600">
                Oddana pojemność: {r.beforeAh.toLocaleString('pl-PL')} Ah →
                <strong>{r.afterAh.toLocaleString('pl-PL')} Ah</strong>
                <span class="text-gray-400"> (nominał {r.nominalAh} Ah)</span>
              </p>
              {r.beforeTime && r.afterTime && (
                <p class="mt-1 text-sm text-gray-600">
                  Czas pod obciążeniem ok. {r.currentA} A: {r.beforeTime} → <strong>{r.afterTime}</strong>
                </p>
              )}
            </div>
          ))
        }
      </div>

      {
        Astro.slots.has('afterCards') && (
          // LFB-007 P4: lets a caller put a CTA right after the three result cards, before the
          // discharge-report photo and closing paragraph. DOM order matches reading/mobile
          // order (cards, then this, then the photo); `lg:order-*` on all three re-sequences
          // just the desktop grid so cards+photo keep their original side-by-side pairing and
          // this becomes a full-width band below that row, instead of splitting the pair.
          // `relative left-1/2 w-screen -translate-x-1/2` breaks the slot's content out of
          // this component's `max-w-6xl px-4` column -- without it a full-bleed component like
          // CtaBand (its own `bg-ink-900` section) would render as an inset card with visible
          // page margins on both sides instead of edge to edge, the one place on the site it
          // would look that way (measured, not assumed -- see LFB-007 README).
          <div class="w-screen ml-[calc(50%-50vw)] mr-[calc(50%-50vw)] lg:order-3 lg:col-span-2">
            <slot name="afterCards" />
          </div>
        )
      }

      <Photo
        photo={PHOTOS.dischargeReport}
        widths={[520, 800, 1400]}
        sizes="(min-width: 1024px) 34rem, 100vw"
        class="rounded-2xl border border-gray-200 bg-white p-3 lg:order-2"
      />
    </div>

    <p class="mt-8 max-w-3xl text-sm text-gray-500">
      Wartości pochodzą z raportów testu rozładowania generowanych przez urządzenie serwisowe.
      Pomiar wykonujemy przy przyjęciu i po zakończeniu programu formowania, na tej samej baterii
      i tym samym prądem. Granica zużycia baterii według norm branżowych to {END_OF_LIFE_PCT}%
      pojemności znamionowej. Poniżej niej nie uznajemy usługi za wykonaną.
    </p>
  </div>
</section>
