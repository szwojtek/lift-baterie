---
import { BEST_RESULT, GAIN_FACTOR_LABEL } from '../config/results';
import { href } from '../utils/url';

interface Props {
  /** Tinted band by default; pass false when the neighbouring section is tinted. */
  tinted?: boolean;
}

const { tinted = true } = Astro.props;
const gain = BEST_RESULT.after - BEST_RESULT.before;
// Older rows only carry Ah; the multiplier line needs both durations from the report.
const hasTimes = Boolean(BEST_RESULT.beforeTime && BEST_RESULT.afterTime);
---

{/*
  The compact half of the proof. The full table plus the report scan lives on
  /realizacje and only there: rendering the whole block on four pages repeated
  roughly 250 words verbatim, which reads as padding to a visitor moving
  between them and spends the proof's impact three extra times.
*/}
<section class={tinted ? 'bg-gray-50' : ''}>
  <div class="mx-auto max-w-6xl px-4 py-12">
    <div class="flex flex-col gap-6 rounded-2xl border border-gray-200 bg-white p-6 sm:flex-row sm:items-center sm:justify-between sm:p-8">
      <div class="flex items-end gap-5">
        <div>
          <p class="text-xs font-semibold uppercase tracking-wide text-gray-400">Przy przyjęciu</p>
          <p class="font-display text-2xl font-bold text-gray-400">{BEST_RESULT.before}%</p>
        </div>
        <p aria-hidden="true" class="pb-2 text-2xl text-brand-300">→</p>
        <div>
          <p class="text-xs font-semibold uppercase tracking-wide text-brand-600">Po regeneracji</p>
          <p class="font-display text-4xl font-bold text-brand-600">{BEST_RESULT.after}%</p>
        </div>
      </div>
      <div class="sm:max-w-md">
        <p class="text-gray-700">
          {hasTimes ? (
            <>
              Bateria oddała <strong>{GAIN_FACTOR_LABEL} razy więcej pojemności</strong>:
              {' '}{BEST_RESULT.afterTime} pod tym samym obciążeniem zamiast {BEST_RESULT.beforeTime}.
              Zmierzone testem rozładowania przed usługą i po niej.
            </>
          ) : (
            <>Wzrost o {gain} punktów procentowych, zmierzony testem rozładowania przed usługą i po niej.</>
          )}
        </p>
        <a
          href={href('/realizacje')}
          class="mt-2 inline-block font-semibold text-brand-600 hover:underline"
        >
          Zobacz raporty z pomiarów →
        </a>
      </div>
    </div>
  </div>
</section>
