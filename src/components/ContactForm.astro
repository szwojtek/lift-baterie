---
import { SITE } from '../config/site';
import { href } from '../utils/url';

interface Props {
  /** Preselect the audience segment (e.g. the TIR page links here with fleet preselected). */
  defaultSegment?: 'wozki' | 'flota';
  buttonLabel?: string;
}

const { defaultSegment = 'wozki', buttonLabel = 'Umów bezpłatną konsultację' } = Astro.props;
---

<form
  id="contact-form"
  class="space-y-4"
  data-key={SITE.web3formsKey}
  data-thanks={href('/dziekujemy')}
  novalidate
>
  <input type="checkbox" name="botcheck" class="hidden" tabindex="-1" autocomplete="off" />

  <div class="grid gap-4 sm:grid-cols-2">
    <label class="block text-sm">
      <span class="font-medium">Imię i nazwisko</span>
      <input name="name" type="text" autocomplete="name" class="mt-1 w-full rounded-lg border border-gray-300 px-3 py-2.5 text-base" />
    </label>
    <label class="block text-sm">
      <span class="font-medium">Firma</span>
      <input name="company" type="text" autocomplete="organization" class="mt-1 w-full rounded-lg border border-gray-300 px-3 py-2.5 text-base" />
    </label>
  </div>

  <div class="grid gap-4 sm:grid-cols-2">
    <label class="block text-sm">
      <span class="font-medium">Telefon <span class="text-red-600">*</span></span>
      <input name="phone" type="tel" required autocomplete="tel" class="mt-1 w-full rounded-lg border border-gray-300 px-3 py-2.5 text-base" />
    </label>
    <label class="block text-sm">
      <span class="font-medium">E-mail</span>
      <input name="email" type="email" autocomplete="email" class="mt-1 w-full rounded-lg border border-gray-300 px-3 py-2.5 text-base" />
    </label>
  </div>

  <div class="grid gap-4 sm:grid-cols-2">
    <label class="block text-sm">
      <span class="font-medium">Czego dotyczy zgłoszenie?</span>
      <select name="segment" class="mt-1 w-full rounded-lg border border-gray-300 px-3 py-2.5 text-base">
        <option value="Wózki widłowe (baterie trakcyjne)" selected={defaultSegment === 'wozki'}>
          Wózki widłowe (baterie trakcyjne)
        </option>
        <option value="Flota ciężarowa (akumulatory 12/24V)" selected={defaultSegment === 'flota'}>
          Flota ciężarowa (akumulatory 12/24 V)
        </option>
      </select>
    </label>
    <label class="block text-sm">
      <span class="font-medium">Liczba baterii / pojazdów</span>
      <select name="quantity" class="mt-1 w-full rounded-lg border border-gray-300 px-3 py-2.5 text-base">
        <option>1–3</option>
        <option>4–10</option>
        <option>11–30</option>
        <option>30+</option>
      </select>
    </label>
  </div>

  <label class="block text-sm">
    <span class="font-medium">Wiadomość</span>
    <textarea name="message" rows="3" class="mt-1 w-full rounded-lg border border-gray-300 px-3 py-2.5 text-base"></textarea>
  </label>

  <button type="submit" class="w-full rounded-lg bg-brand-600 px-6 py-3.5 font-semibold text-white transition hover:bg-brand-700">
    {buttonLabel}
  </button>
  <p class="text-center text-xs text-gray-500">Oddzwonimy w ciągu 24 h w dni robocze.</p>
  <p class="text-center text-xs text-gray-500">
    Administratorem danych jest FTU „LIFT” Dariusz Kozieł. Dane posłużą wyłącznie do odpowiedzi na
    zapytanie. Szczegóły: <a href={href('/privacy-policy')} class="underline">polityka prywatności</a>.
  </p>
  <p id="form-status" role="status" aria-live="polite" class="hidden rounded-lg bg-amber-50 px-4 py-3 text-sm text-amber-800"></p>
</form>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const status = document.getElementById('form-status');

  const showStatus = (message: string) => {
    if (!status) return;
    status.textContent = message;
    status.classList.remove('hidden');
  };

  const submit = form?.querySelector<HTMLButtonElement>('button[type="submit"]') ?? null;
  const submitLabel = submit?.textContent ?? '';
  // Locks the button from the moment the request leaves until the redirect lands: without it the
  // ~1 s of no visible change read as "nothing happened" and people sent the form twice (24.09).
  const setSending = (sending: boolean) => {
    if (!submit) return;
    submit.disabled = sending;
    submit.setAttribute('aria-busy', String(sending));
    submit.textContent = sending ? 'Wysyłanie…' : submitLabel;
    submit.classList.toggle('opacity-70', sending);
    submit.classList.toggle('cursor-wait', sending);
  };

  // Coming back from /dziekujemy with the browser's Back button restores the page from cache with the
  // button still locked; unlock it so a second, deliberate enquiry stays possible.
  window.addEventListener('pageshow', (event) => {
    if (event.persisted) setSending(false);
  });

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (submit?.disabled) return;
    if ((form.elements.namedItem('botcheck') as HTMLInputElement | null)?.checked) return;

    const phone = (form.elements.namedItem('phone') as HTMLInputElement).value.trim();
    if (phone.replace(/\D/g, '').length < 9) {
      showStatus('Podaj prawidłowy numer telefonu. Oddzwonimy w ciągu 24 h.');
      return;
    }

    const accessKey = form.dataset.key;
    if (!accessKey) {
      showStatus('Formularz jest jeszcze w przygotowaniu. Zadzwoń: 695 946 842.');
      return;
    }

    // Web3Forms prints each key as the field heading in the notification email, so the keys sent are the
    // Polish labels the recipient reads. Empty optional fields are left out instead of arriving blank.
    const data = new FormData(form);
    const value = (key: string) => String(data.get(key) ?? '').trim();
    const labels: Record<string, string> = {
      name: 'Imię i nazwisko',
      company: 'Firma',
      phone: 'Telefon',
      email: 'E-mail',
      segment: 'Czego dotyczy zgłoszenie',
      quantity: 'Liczba baterii / pojazdów',
      message: 'Wiadomość',
    };
    const fields = Object.fromEntries(
      Object.entries(labels)
        .filter(([key]) => value(key) !== '')
        .map(([key, label]) => [label, value(key)]),
    );
    // With the email field renamed, Web3Forms no longer infers the reply-to address, so it is passed explicitly.
    const email = value('email');

    setSending(true);
    try {
      const response = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify({
          access_key: accessKey,
          subject: 'Zapytanie z lift-baterie.pl',
          from_name: 'lift-baterie.pl',
          ...(email ? { replyto: email } : {}),
          ...fields,
        }),
      });
      if (!response.ok) throw new Error(String(response.status));

      window.dataLayer = window.dataLayer || [];
      window.dataLayer.push({ event: 'form_submit' });
      // Redirecting immediately would unload the page before GTM tags fire;
      // the /dziekujemy pageview is the primary conversion signal, this event is auxiliary.
      const thanks = form.dataset.thanks ?? '/dziekujemy';
      setTimeout(() => {
        window.location.href = thanks;
      }, 400);
    } catch {
      setSending(false);
      showStatus('Coś poszło nie tak. Prosimy spróbować ponownie lub zadzwonić: 695 946 842.');
    }
  });
</script>
