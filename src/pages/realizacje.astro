---
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBand from '../components/CtaBand.astro';
import Photo from '../components/Photo.astro';
import ResultsTable from '../components/ResultsTable.astro';
import { PHOTOS } from '../config/photos';
import { testimonialOsmWloszczowa, testimonialUnimax, testimonialFirmaLogistyczna } from '../data/testimonials';

const gallery = [
  PHOTOS.batteryUnderRegeneration,
  PHOTOS.clampMeterDiagnostics,
  PHOTOS.openCellsDetail,
  PHOTOS.batteryNameplate,
  PHOTOS.batteryCellsTopview,
  PHOTOS.cellsConnectorsDetail,
];

const cases = [
  {
    firm: testimonialOsmWloszczowa.author,
    tag: testimonialOsmWloszczowa.context,
    quote: testimonialOsmWloszczowa.quote,
  },
  {
    firm: testimonialUnimax.author,
    tag: testimonialUnimax.context,
    quote: testimonialUnimax.quote,
  },
  {
    firm: testimonialFirmaLogistyczna.author,
    tag: testimonialFirmaLogistyczna.context,
    quote: testimonialFirmaLogistyczna.quote,
  },
  {
    firm: 'Fabryka tworzyw sztucznych, Małopolska',
    tag: '10 baterii w 3 dni',
    quote: 'Realizacja rotacyjnie, bez wyłączania stref. Dziesięć sztuk zrobionych w trzy dni. Magazyn działał normalnie.',
  },
  {
    firm: 'Magazyn e-commerce, Pomorskie',
    tag: 'Parametry trzymają do dziś',
    quote: 'Po usłudze dostaliśmy raport przed/po i proste zalecenia dla operatorów. Parametry trzymają do dziś.',
  },
];
---

<BaseLayout
  title="Realizacje: regeneracja baterii w praktyce | LIFT Baterie"
  description="Zobacz realizacje LIFT Baterie: regeneracja i formatowanie baterii trakcyjnych u klientów w całej Polsce, z liczbami i raportami przed/po."
>
  <section class="mx-auto max-w-6xl px-4 pt-16 pb-10">
    <h1 class="font-display text-3xl font-bold sm:text-4xl">Realizacje</h1>
    <p class="mt-4 max-w-2xl text-gray-600">
      Każdą usługę kończymy raportem przed/po. Poniżej wybrane wdrożenia u klientów z całej Polski.
    </p>
  </section>

  {/* Measurements lead: links across the site promise "raporty z pomiarów" and land here. */}
  <ResultsTable />

  <!-- GALLERY -->
  <section class="mx-auto max-w-6xl px-4 py-16">
    <h2 class="border-l-4 border-brand-500 pl-4 font-display text-2xl font-bold sm:text-3xl">
      Jak to wygląda w praktyce
    </h2>
    <p class="mt-4 max-w-2xl text-gray-600">
      Zdjęcia z naszych realizacji: diagnostyka, przegląd ogniw i praca urządzeń u klienta.
    </p>
    <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        gallery.map((photo) => (
          <Photo
            photo={photo}
            widths={[400, 640, 900]}
            sizes="(min-width: 1024px) 22rem, (min-width: 640px) 45vw, 100vw"
            ratio="aspect-[4/3]"
          />
        ))
      }
    </div>
  </section>

  <!-- TESTIMONIALS -->
  <section class="mx-auto max-w-6xl px-4 py-16">
    <h2 class="border-l-4 border-brand-500 pl-4 font-display text-2xl font-bold sm:text-3xl">
      Opinie klientów
    </h2>
    <div class="mt-10 grid gap-6 md:grid-cols-2">
      {cases.map((c) => (
        <figure class="rounded-2xl border border-gray-200 p-6">
          <p class="text-sm font-bold text-brand-600">{c.tag}</p>
          <blockquote class="mt-3 text-gray-700">„{c.quote}”</blockquote>
          <figcaption class="mt-4 text-sm font-semibold text-gray-500">{c.firm}</figcaption>
        </figure>
      ))}
    </div>
    <p class="mt-6 text-sm text-gray-500">
      Część klientów prosi o anonimizację nazw. Pełne dane referencyjne udostępniamy do wglądu na życzenie, podczas konsultacji.
    </p>
  </section>

  <CtaBand title="Twoja hala może być następna" />
</BaseLayout>
