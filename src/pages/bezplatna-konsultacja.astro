---
import TrustBar from '../components/TrustBar.astro';
import PhoneIcon from '../components/icons/PhoneIcon.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';
import Hero from '../components/Hero.astro';
import ProofStrip from '../components/ProofStrip.astro';
import { PHOTOS } from '../config/photos';
import { SITE } from '../config/site';
---

<BaseLayout
  title="Bezpłatna konsultacja baterii trakcyjnych | LIFT Baterie"
  description="Umów bezpłatną konsultację: opisz objawy, wyślij zdjęcia baterii, a powiemy, czy regeneracja ma sens i co dalej. Bez zobowiązań."
>
  <Hero variant="compact" photo={PHOTOS.clampMeterDiagnostics}>
    <Fragment slot="title">Umów bezpłatną konsultację</Fragment>
    <Fragment slot="subtitle">
      Rozmowa telefoniczna, zdjęcia baterii, wstępna rekomendacja. Bez zobowiązań.
    </Fragment>
  </Hero>

  <TrustBar items={[`Od ${SITE.foundingYear} roku`, 'Cała Polska, dojazd do klienta', 'Bezpłatna konsultacja na start', 'Raport przed/po']} />

  <section class="mx-auto max-w-2xl px-4 py-12">
    <a
      href={SITE.phoneHref}
      class="flex items-center justify-center gap-2 rounded-xl bg-brand-600 px-6 py-4 text-lg font-bold text-white transition hover:bg-brand-700"
    >
      <PhoneIcon /> Wolisz porozmawiać? Zadzwoń: {SITE.phoneDisplay}
    </a>
    <p class="my-6 text-center text-sm font-semibold uppercase tracking-wide text-gray-500">albo zostaw kontakt</p>
    <ContactForm />
  </section>

  <section class="bg-gray-50">
    <div class="mx-auto max-w-3xl px-4 py-12">
      <h2 class="text-center font-display text-2xl font-bold">Jak wygląda konsultacja?</h2>
      <div class="mt-8 grid gap-6 sm:grid-cols-3">
        <div class="rounded-2xl bg-white p-6 text-center shadow-sm">
          <p class="font-display text-2xl font-bold text-brand-600">1</p>
          <p class="mt-2 text-sm text-gray-700">Rozmawiasz z technikiem, nie z handlowcem: objawy, wiek baterii, jak jest ładowana.</p>
        </div>
        <div class="rounded-2xl bg-white p-6 text-center shadow-sm">
          <p class="font-display text-2xl font-bold text-brand-600">2</p>
          <p class="mt-2 text-sm text-gray-700">Wysyłasz zdjęcia baterii i tabliczki znamionowej. To zwykle wystarcza do wstępnej oceny.</p>
        </div>
        <div class="rounded-2xl bg-white p-6 text-center shadow-sm">
          <p class="font-display text-2xl font-bold text-brand-600">3</p>
          <p class="mt-2 text-sm text-gray-700">Dostajesz odpowiedź: czy regeneracja ma sens i jak wyglądałaby u Ciebie. Decyzja należy do Ciebie.</p>
        </div>
      </div>
    </div>
  </section>

  <ProofStrip tinted={false} />
</BaseLayout>
