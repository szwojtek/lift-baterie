---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';
import { SITE } from '../config/site';

/*
 * No map link here on purpose. The address is the registered seat, an
 * accountant's office with no LIFT signage and nobody to receive a visitor;
 * a "show on the map" button invites somebody to drive to it. Linking out to
 * Google Maps is not a ranking signal either, so removing it costs no SEO:
 * local search runs on NAP consistency in the text, the PostalAddress in the
 * LocalBusiness schema, and the Google Business Profile. All three stay.
 */
---

<BaseLayout
  title="Kontakt | LIFT Baterie, Kielce, serwis w całej Polsce"
  description="Skontaktuj się z LIFT Baterie: Tel. 695 946 842. Kielce, ul. Wojska Polskiego 7/5A. Mobilny serwis baterii przemysłowych w całej Polsce."
>
  <section class="mx-auto max-w-6xl px-4 py-16">
    <h1 class="font-display text-3xl font-bold sm:text-4xl">Kontakt: porozmawiajmy o Twoich bateriach</h1>

    <div class="mt-10 grid gap-10 md:grid-cols-2">
      <div>
        <ul class="space-y-4 text-gray-700">
          <li>
            <p class="text-sm font-semibold uppercase tracking-wide text-gray-500">Telefon</p>
            <a href={SITE.phoneHref} class="text-2xl font-bold text-brand-600 hover:underline">{SITE.phoneDisplay}</a>
          </li>
          <li>
            <p class="text-sm font-semibold uppercase tracking-wide text-gray-500">E-mail</p>
            <a href={`mailto:${SITE.email}`} class="font-semibold hover:underline">{SITE.email}</a>
          </li>
          <li>
            <p class="text-sm font-semibold uppercase tracking-wide text-gray-500">Obszar działania</p>
            <p>Cała Polska, serwis mobilny z dojazdem do klienta.</p>
          </li>
          <li>
            <p class="text-sm font-semibold uppercase tracking-wide text-gray-500">Adres rejestrowy</p>
            <p>{SITE.address.street}, {SITE.address.zip} {SITE.address.city}</p>
            <p class="mt-1 text-sm text-gray-500">
              Siedziba do korespondencji. Nie prowadzimy tu obsługi klientów: przyjeżdżamy do Was.
            </p>
          </li>
          {SITE.googleReviewsUrl && (
            <li>
              <a href={SITE.googleReviewsUrl} target="_blank" rel="noopener" class="font-semibold text-brand-600 hover:underline">
                Zobacz nasze opinie w Google →
              </a>
            </li>
          )}
        </ul>
        <p class="mt-8 text-xs text-gray-500">
          {SITE.name} to marka {SITE.legalName}. NIP {SITE.nip}, REGON {SITE.regon}.
        </p>
      </div>

      <div>
        <h2 class="mb-4 font-display text-xl font-bold">Napisz do nas</h2>
        <ContactForm />
      </div>
    </div>
  </section>
</BaseLayout>
